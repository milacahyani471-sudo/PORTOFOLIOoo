        // Subnet Calculator Logic Engine
        function runSubnetCalc() {
            const ipStr = document.getElementById('ip-input').value.trim();
            const cidr = parseInt(document.getElementById('cidr-input').value);

            const ipOctets = ipStr.split('.');
            if (ipOctets.length !== 4 || ipOctets.some(o => isNaN(o) || o < 0 || o > 255)) {
                alert('Format Alamat IP tidak valid! Silakan masukkan contoh IP seperti: 192.168.10.1');
                return;
            }

            const ipNum = ipOctets.reduce((acc, octet) => (acc << 8) + parseInt(octet), 0) >>> 0;
            const maskNum = (0xFFFFFFFF << (32 - cidr)) >>> 0;
            const netNum = (ipNum & maskNum) >>> 0;
            const bcastNum = (netNum | (~maskNum >>> 0)) >>> 0;

            const formatIp = num => [
                (num >>> 24) & 255,
                (num >>> 16) & 255,
                (num >>> 8) & 255,
                num & 255
            ].join('.');

            document.getElementById('res-mask').innerText = formatIp(maskNum);
            document.getElementById('res-net').innerText = formatIp(netNum);
            document.getElementById('res-bcast').innerText = formatIp(bcastNum);
            document.getElementById('res-range').innerText = `${formatIp(netNum + 1)} - ${formatIp(bcastNum - 1)}`;
            document.getElementById('res-total').innerText = `${Math.max(0, Math.pow(2, 32 - cidr) - 2)} Hosts`;
        }

